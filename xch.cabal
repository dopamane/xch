cabal-version:      3.0
name:               xchange
version:            0.1.0.0
synopsis:           Space Data Exchange
description:        ASTM F3514-21
homepage:           https://github.com/dopamane/xchange
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
  type: git
  location: https://github.com/dopamane/xchange

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Data.Xch
  build-depends:
    base < 5,
    prettyprinter,
    time

executable xch
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_xchange
  autogen-modules:  Paths_xchange
  build-depends:
    base < 5,
    optparse-applicative,
    xchange,

test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    base < 5,
    xchange
